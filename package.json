{
  "name": "re-hub-for-atk",
  "private": true,
  "version": "1.3.1",
  "description": "Unofficial, open-source, local-first WebHID configurator for ATK mice and keyboards.",
  "license": "MIT",
  "author": "Scide",
  "homepage": "https://github.com/ScideCodes/ReHUB-for-ATK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScideCodes/ReHUB-for-ATK.git"
  },
  "bugs": {
    "url": "https://github.com/ScideCodes/ReHUB-for-ATK/issues"
  },
  "keywords": [
    "atk",
    "webhid",
    "gaming-mouse",
    "mechanical-keyboard",
    "configurator",
    "react",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:devices": "vitest run --config vitest.matrix.config.ts",
    "test:cls": "node scripts/open-flow-cls.mjs",
    "shots": "node scripts/shots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:unused": "knip",
    "audit:browser": "node scripts/audit-browser.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "registry:generate": "node scripts/generate-registry.mjs",
    "layouts:generate": "node scripts/generate-keyboard-layouts.mjs",
    "prebuild": "npm run registry:generate",
    "audit:colors": "node scripts/color-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "8.19.0",
    "autoprefixer": "^10.4.20",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "happy-dom": "^21.0.3",
    "knip": "6.42.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.72.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  }
}
